# 1-hive settings shared by the deploy scripts. No secrets here.
HIVE_ID=1-hive
HIVE_PROFILE=1-hive
HIVE_MODE=authoritative
HIVE_DB=onehive
HIVE_DB_PREFIX=onehive
HIVE_DB_PORT=5433
HIVE_GATEWAY_PORT=8470
HIVE_RECORD_REF=spec-v1.0-a6
# The hive/hive-pin tools can be newer than the pinned policy (their protocol is the policy's).
HIVE_RECORD_TOOL_REF=v1.4.0
# The operating loop and the human surfaces (github.com/1-hive): installed by up.sh at these tags.
HIVE_RUNTIME_REF=v0.5.64
HIVE_BRIDGE_REF=v0.5.42
# hive-skills: the hive-skill command (One Hive R4); deploy/skills.json is the registry
HIVE_SKILLS_REF=v1.0.0
HIVE_CONFIG_DIR=$HOME/.config/hive
HIVE_ARCHIVE_DIR=$HOME/.local/share/1-hive/archive
OPERATOR_ID=operator
OPERATOR_KEY=ed25519:x9aTLxzFPp1RfYKcKkNkLaJ4Lg7oOycAdnv90j8o83A
